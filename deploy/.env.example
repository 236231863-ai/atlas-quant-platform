# Atlas Mobile MVP - 环境变量示例（部署时复制为 .env 并填真实值）
# ⚠️ .env 文件严禁提交到 Git（已在 .gitignore 或勿 add）
# ⚠️ 真实 AppSecret 只填在服务器上的 .env，不上传代码仓库

# 微信小程序凭证（必须）
WX_APPID=wxe254d2aded63ca94
# WX_APPSECRET=<在服务器上填写真实值>

# SQLite 数据库目录（必须，建议 /opt/atlas/data）
DATABASE_PATH=/opt/atlas/data

# 生产环境开关（保持 0 = 关闭 mock）
WECHAT_LOGIN_MOCK=0
WECHAT_MOCK=0

# 订阅消息模板（可选，配置后真实推送开奖提醒）
# WECHAT_TEMPLATE_ID=<模板ID>
