.container { padding: 32px 24px; background: linear-gradient(180deg, #2b6cb0 0%, #f7f9fc 300px); min-height: 100vh; }
.hero { text-align: center; padding: 20px 0 32px; }
.logo { font-size: 56px; display: block; }
.title { font-size: 26px; font-weight: 700; color: #fff; display: block; margin-top: 8px; }
.badge { display: inline-block; font-size: 12px; background: #ed8936; color: #fff; border-radius: 8px; padding: 2px 10px; margin-top: 8px; }
.subtitle { font-size: 14px; color: #ebf4ff; display: block; margin-top: 8px; }
.features { background: #fff; border-radius: 16px; padding: 8px 20px; margin: 8px 0 24px; }
.feat { display: flex; padding: 16px 0; border-bottom: 1px solid #f0f0f0; }
.feat:last-child { border-bottom: none; }
.f-icon { font-size: 26px; margin-right: 14px; }
.f-title { font-size: 16px; font-weight: 600; display: block; }
.f-desc { font-size: 13px; color: #888; display: block; margin-top: 4px; }
.primary-btn { background: #2b6cb0; color: #fff; }
.tip { display: block; text-align: center; font-size: 13px; color: #666; margin-top: 16px; }
.disclaimer { display: block; text-align: center; font-size: 12px; color: #999; margin-top: 8px; }
