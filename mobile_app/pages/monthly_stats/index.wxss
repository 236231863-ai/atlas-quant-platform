.container { padding: 24px; background: #f7f9fc; min-height: 100vh; }
.title { font-size: 22px; font-weight: 700; display: block; margin-bottom: 16px; }
.grid { display: flex; flex-wrap: wrap; gap: 12px; }
.stat { background: #fff; border-radius: 12px; padding: 20px; width: 46%; text-align: center; }
.label { font-size: 13px; color: #888; display: block; }
.value { font-size: 22px; font-weight: 700; display: block; margin-top: 8px; }
.value.neg { color: #e53e3e; }
.disclaimer { display: block; font-size: 12px; color: #999; margin-top: 24px; text-align: center; }
