.container { height: 100vh; display: flex; flex-direction: column; background: #f7f9fc; }
.swiper { flex: 1; }
.slide { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.icon { font-size: 80px; margin-bottom: 24px; }
.title { font-size: 28px; font-weight: 600; margin-bottom: 12px; }
.desc { font-size: 16px; color: #666; padding: 0 40px; text-align: center; }
.dots { display: flex; justify-content: center; margin-bottom: 24px; }
.dot { width: 8px; height: 8px; border-radius: 4px; background: #ccc; margin: 0 6px; }
.dot.active { background: #2b6cb0; width: 20px; }
.primary-btn { margin: 0 32px 16px; background: #2b6cb0; color: #fff; border-radius: 12px; }
.disclaimer { text-align: center; font-size: 12px; color: #999; margin-bottom: 24px; }
